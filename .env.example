# Used by docker-compose.yml. Copy to .env and edit. Never commit .env.
POSTGRES_DB=ipl_draft
POSTGRES_USER=ipl_user
POSTGRES_PASSWORD=change_me

# Firebase (server side). Project id is required for token verification.
FIREBASE_PROJECT_ID=
# Optional: service-account JSON placed in ./secrets/ (git-ignored), e.g. /run/secrets/firebase/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_SAMPLE_DATA=true

# Firebase (browser side, public web-app config)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
